# ==========================================
# Instagram Reel Scraper & Transcription API
# Copy this file to .env and fill in values
# ==========================================

# 1. API Security
API_KEY=my_instagram_scraper_secret_key_123

# 2. Server
HOST=0.0.0.0
PORT=8000

# 3. Webhook (leave empty to disable)
WEBHOOK_URL=

# 4. Transcription
TRANSCRIPTION_PROVIDER=openai    # "local" | "openai"
OPENAI_API_KEY=                  # required when TRANSCRIPTION_PROVIDER=openai
LOCAL_WHISPER_MODEL=base         # tiny|base|small|medium|large-v3

# 5. Database & Redis
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin
POSTGRES_DB=insta_reel_scraper
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://admin:admin@postgres:5432/insta_reel_scraper
REDIS_URL=redis://admin:admin123@redis:6379/0
DOCKER_NETWORK=postgres-network

# 6. Storage & Scraper
STORAGE_DIR=/app/storage
CLEANUP_TEMP_FILES=true
TIMEOUT_MS=30000
HEADLESS=true

# 7. Per-Stage Worker Concurrency
N_SCRAPE_WORKERS=3
SCRAPE_BROWSER_POOL_SIZE=3
N_DOWNLOAD_WORKERS=8
N_AUDIO_WORKERS=4
N_LOCAL_WHISPER_WORKERS=2
N_OPENAI_WORKERS=10
N_WEBHOOK_WORKERS=4
WEBHOOK_MAX_RETRIES=5
SCRAPE_REQUEST_JITTER_MIN_MS=500
SCRAPE_REQUEST_JITTER_MAX_MS=2000
